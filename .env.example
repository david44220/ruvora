# LOCAL DEVELOPMENT ONLY. Copy to .env; do not commit .env.
DATABASE_URL=postgresql://ruvora:ruvora-local-only@127.0.0.1:54329/ruvora
TEST_DATABASE_URL=postgresql://ruvora:ruvora-local-only@127.0.0.1:54329/ruvora_test
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
LOCAL_POSTGRES_PORT=54329

# Development seed and simulated campaign funding. Production rejects these paths.
ALLOW_DEV_SEED=true
ALLOW_DEMO_FUNDING=true
# REQUIRED before pnpm db:seed: choose a local-only password of at least 12 characters.
# The seed uses this password for all documented @ruvora.test development accounts.
DEMO_PASSWORD=

# Docker Compose development database. Stop db:local before using the same port.
POSTGRES_USER=ruvora
POSTGRES_DB=ruvora
POSTGRES_PASSWORD=ruvora-local-only
POSTGRES_PORT=54329

# Production: replace all local credentials, use HTTPS origins and a protected
# PostgreSQL connection, omit DEMO_PASSWORD, set both ALLOW_* flags to false.
# Never place secrets in NEXT_PUBLIC_* variables.

# One-time first-admin bootstrap. Leave disabled in normal app environments.
ALLOW_ADMIN_BOOTSTRAP=false
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=

# Canonical public URL and explicit UI environment label.
PUBLIC_SITE_URL=http://localhost:3000
APP_ENV=development
