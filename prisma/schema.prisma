generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  CREATOR
  ADVERTISER
  ADMIN
}

enum CampaignState {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  PAUSED
  COMPLETED
  REJECTED
  ARCHIVED
}

enum ActivityType {
  IMPRESSION
  QUALIFIED_VIEW
  CLICK
  CONVERSION
  CREATOR_PROMOTION
  SPONSORED_MISSION
}

enum ActivityState {
  PENDING_VALIDATION
  VALIDATED
  REJECTED
  REVERSED
}

enum RewardState {
  PENDING
  VALIDATED
  REJECTED
  CONSUMED
  REVERSED
}

enum ParticipantCategory {
  USER
  CREATOR
  ADVERTISER
  REFERRAL
}

enum AccountKind {
  CASH_CLEARING
  CAMPAIGN_ESCROW
  PLATFORM_REVENUE
  GLOBAL_DISTRIBUTION_POOL
  USER_PAYABLE
  EVENT_PRIZE
  ADVERTISER_AVAILABLE
}

model User {
  mfaCredential                MfaCredential?
  mfaEnrollment                MfaEnrollment?
  mfaRecoveryCodes             MfaRecoveryCode[]
  emailSecurityTokens          EmailSecurityToken[]
  mailOutbox                   MailOutbox[]
  requestedApprovals           FinancialApproval[]  @relation("ApprovalRequester")
  reviewedApprovals            FinancialApproval[]  @relation("ApprovalReviewer")
  paymentOperations            PaymentOperation[]
  participantDisqualifications EventMembership[]    @relation("ParticipantDisqualifier")
  id                           String               @id @default(cuid())
  email                        String               @unique
  passwordHash                 String
  displayName                  String
  handle                       String?              @unique
  roles                        Role[]               @default([USER])
  locale                       String               @default("en")
  country                      String?
  bio                          String               @default("")
  category                     String               @default("Creator")
  socialLinks                  Json                 @default("[]")
  customLinks                  Json                 @default("[]")
  followers                    Int                  @default(0)
  audienceStatus               String               @default("SELF_DECLARED")
  onboarded                    Boolean              @default(false)
  ageEligible                  Boolean              @default(false)
  termsAcceptedAt              DateTime?
  suspended                    Boolean              @default(false)
  economicHold                 Boolean              @default(false)
  isDemo                       Boolean              @default(false)
  createdAt                    DateTime             @default(now())
  updatedAt                    DateTime             @updatedAt
  sessions                     Session[]
  campaigns                    Campaign[]           @relation("Advertiser")
  activities                   Activity[]           @relation("Participant")
  creatorActivities            Activity[]           @relation("AttributedCreator")
  rewardUnits                  RewardUnit[]
  xpEntries                    XpEntry[]
  eventPoints                  EventPoint[]
  eventMemberships             EventMembership[]
  accounts                     LedgerAccount[]
  referralsSent                Referral[]           @relation("Inviter")
  referralReceived             Referral?            @relation("Invitee")
  auditLogs                    AuditLog[]
  riskEvents                   RiskEvent[]
  ownedShareLinks              ShareLink[]          @relation("ShareOwner")
  creatorShareLinks            ShareLink[]          @relation("ShareCreator")
  referralShareLinks           ShareLink[]          @relation("ShareReferrer")
  creatorAttributions          AttributionContext[] @relation("AttributionCreator")
  referrerAttributions         AttributionContext[] @relation("AttributionReferrer")
  boundAttributions            AttributionContext[] @relation("AttributionAccount")
  growthActions                GrowthEvent[]        @relation("GrowthActor")
  creatorGrowth                GrowthEvent[]        @relation("GrowthCreator")
  ownedEvents                  Event[]              @relation("EventOwner")
  sponsoredEvents              Event[]              @relation("EventSponsor")
  hostedEvents                 Event[]              @relation("EventHost")
  reviewedEvents               Event[]              @relation("EventReviewer")
  eventSettlements             EventSettlement[]
  eventOperations              EventOperation[]
  emailVerifiedAt              DateTime?
  mfaEnabledAt                 DateTime?
  profileModules               Json                 @default("[]")
}

model Session {
  mfaEnrollments  MfaEnrollment[]
  id              String          @id
  tokenHash       String          @unique
  userId          String
  expiresAt       DateTime
  createdAt       DateTime        @default(now())
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  authenticatedAt DateTime        @default(now())
  mfaVerifiedAt   DateTime?

  @@index([expiresAt])
}

model RateLimit {
  key       String   @id
  count     Int      @default(1)
  windowEnd DateTime

  @@index([windowEnd])
}

model Campaign {
  providerConversions     ProviderConversion[]
  id                      String               @id @default(cuid())
  advertiserId            String
  name                    String
  description             String               @default("")
  objective               ActivityType
  destinationUrl          String
  budgetMinor             BigInt
  dailyBudgetMinor        BigInt
  unitCostMinor           BigInt
  currency                String               @default("EUR")
  state                   CampaignState        @default(DRAFT)
  startAt                 DateTime
  endAt                   DateTime
  frequencyCap            Int                  @default(3)
  eventId                 String?
  reviewReason            String?
  isDemo                  Boolean              @default(false)
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  advertiser              User                 @relation("Advertiser", fields: [advertiserId], references: [id])
  event                   Event?               @relation(fields: [eventId], references: [id])
  activities              Activity[]
  accounts                LedgerAccount[]
  shareLinks              ShareLink[]
  attributionContexts     AttributionContext[]
  growthEvents            GrowthEvent[]
  allowedCountries        String[]             @default([])
  creatorCategories       String[]             @default([])
  minimumCreatorFollowers Int                  @default(0)

  @@index([state, startAt, endAt])
  @@index([advertiserId, createdAt])
}

model Activity {
  providerConversions ProviderConversion[]
  id                  String               @id @default(cuid())
  idempotencyKey      String               @unique
  userId              String
  creatorId           String?
  campaignId          String
  eventId             String?
  type                ActivityType
  state               ActivityState        @default(PENDING_VALIDATION)
  billableMinor       BigInt               @default(0)
  evidence            String?
  reviewReason        String?
  ruleVersion         String?
  validatedAt         DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  user                User                 @relation("Participant", fields: [userId], references: [id])
  creator             User?                @relation("AttributedCreator", fields: [creatorId], references: [id])
  campaign            Campaign             @relation(fields: [campaignId], references: [id])
  event               Event?               @relation(fields: [eventId], references: [id])
  rewards             RewardUnit[]
  xpEntries           XpEntry[]
  eventPoints         EventPoint[]
  attributionId       String?
  attributionSnapshot Json?
  requestFingerprint  String?
  attribution         AttributionContext?  @relation(fields: [attributionId], references: [id], onDelete: Restrict)
  referralCredit      ReferralCredit?

  @@index([campaignId, userId, createdAt])
  @@index([state, createdAt])
  @@index([attributionId])
}

model EconomicRule {
  id            String         @id @default(cuid())
  version       String         @unique
  config        Json
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  distributions Distribution[]
}

model RewardUnit {
  id             String              @id @default(cuid())
  userId         String
  activityId     String
  category       ParticipantCategory
  amountMicros   BigInt
  state          RewardState         @default(VALIDATED)
  ruleVersion    String
  distributionId String?
  createdAt      DateTime            @default(now())
  user           User                @relation(fields: [userId], references: [id])
  activity       Activity            @relation(fields: [activityId], references: [id])
  distribution   Distribution?       @relation(fields: [distributionId], references: [id])
  referralCredit ReferralCredit?

  @@unique([activityId, userId, category])
  @@index([state, createdAt])
  @@index([userId, state])
}

model XpEntry {
  id         String   @id @default(cuid())
  userId     String
  activityId String
  amount     Int
  reversal   Boolean  @default(false)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
  activity   Activity @relation(fields: [activityId], references: [id])

  @@unique([activityId, userId, reversal])
  @@index([userId])
}

model Event {
  id                  String               @id @default(cuid())
  slug                String               @unique
  title               String
  description         String
  artwork             String               @default("/assets/events/ruvora-event.webp")
  sponsor             String?
  startAt             DateTime
  endAt               DateTime
  rules               Json
  state               String               @default("ACTIVE")
  isDemo              Boolean              @default(false)
  createdAt           DateTime             @default(now())
  campaigns           Campaign[]
  activities          Activity[]
  memberships         EventMembership[]
  points              EventPoint[]
  accounts            LedgerAccount[]
  shareLinks          ShareLink[]
  attributionContexts AttributionContext[]
  growthEvents        GrowthEvent[]
  ownerId             String?
  sponsorId           String?
  hostId              String?
  localizedContent    Json                 @default("{}")
  configuration       Json                 @default("{}")
  configVersion       String               @default("legacy-event-v1")
  prizeBudgetMinor    BigInt               @default(0)
  visibility          String               @default("PUBLIC")
  fundingState        String               @default("UNFUNDED")
  reviewedById        String?
  reviewedAt          DateTime?
  reviewReason        String?
  approvedSnapshot    Json?
  completedAt         DateTime?
  cancelledAt         DateTime?
  owner               User?                @relation("EventOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  sponsorUser         User?                @relation("EventSponsor", fields: [sponsorId], references: [id], onDelete: Restrict)
  host                User?                @relation("EventHost", fields: [hostId], references: [id], onDelete: Restrict)
  reviewer            User?                @relation("EventReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  settlements         EventSettlement[]
  operations          EventOperation[]

  @@index([ownerId, state])
  @@index([sponsorId, state])
}

model EventMembership {
  disqualifiedBy         User?     @relation("ParticipantDisqualifier", fields: [disqualifiedById], references: [id], onDelete: Restrict)
  id                     String    @id @default(cuid())
  userId                 String
  eventId                String
  joinedAt               DateTime  @default(now())
  user                   User      @relation(fields: [userId], references: [id])
  event                  Event     @relation(fields: [eventId], references: [id])
  disqualified           Boolean   @default(false)
  disqualificationReason String?
  disqualifiedById       String?
  disqualifiedAt         DateTime?

  @@unique([eventId, userId])
}

model EventPoint {
  id          String   @id @default(cuid())
  userId      String
  eventId     String
  activityId  String
  amount      Int
  reversal    Boolean  @default(false)
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
  event       Event    @relation(fields: [eventId], references: [id])
  activity    Activity @relation(fields: [activityId], references: [id])
  ruleVersion String   @default("legacy-event-v1")

  @@unique([activityId, userId, eventId, reversal])
  @@index([eventId, userId])
}

model LedgerAccount {
  id         String        @id
  kind       AccountKind
  currency   String        @default("EUR")
  userId     String?
  campaignId String?
  eventId    String?
  createdAt  DateTime      @default(now())
  user       User?         @relation(fields: [userId], references: [id])
  campaign   Campaign?     @relation(fields: [campaignId], references: [id])
  event      Event?        @relation(fields: [eventId], references: [id])
  entries    LedgerEntry[]
}

model LedgerTransaction {
  paymentOperation PaymentOperation?
  id               String             @id @default(cuid())
  idempotencyKey   String             @unique
  kind             String
  referenceId      String
  description      String
  reversesId       String?            @unique
  createdTxid      BigInt             @default(dbgenerated("txid_current()")) @map("created_txid")
  isDemo           Boolean            @default(false)
  createdAt        DateTime           @default(now())
  reverses         LedgerTransaction? @relation("Reversal", fields: [reversesId], references: [id])
  reversal         LedgerTransaction? @relation("Reversal")
  entries          LedgerEntry[]

  @@index([referenceId])
}

model LedgerEntry {
  id            String            @id @default(cuid())
  transactionId String
  accountId     String
  amountMinor   BigInt
  createdAt     DateTime          @default(now())
  transaction   LedgerTransaction @relation(fields: [transactionId], references: [id])
  account       LedgerAccount     @relation(fields: [accountId], references: [id])

  @@unique([transactionId, accountId])
  @@index([accountId, createdAt])
}

model Distribution {
  id             String       @id @default(cuid())
  startAt        DateTime
  endAt          DateTime
  ruleId         String
  snapshot       Json
  fingerprint    String
  state          String       @default("PREVIEW")
  finalizedAt    DateTime?
  idempotencyKey String?      @unique
  createdAt      DateTime     @default(now())
  rule           EconomicRule @relation(fields: [ruleId], references: [id])
  rewardUnits    RewardUnit[]

  @@index([state, startAt, endAt])
}

model Referral {
  id            String              @id @default(cuid())
  inviterId     String
  inviteeId     String              @unique
  state         String              @default("PENDING")
  createdAt     DateTime            @default(now())
  inviter       User                @relation("Inviter", fields: [inviterId], references: [id])
  invitee       User                @relation("Invitee", fields: [inviteeId], references: [id])
  attributionId String?             @unique
  ruleSnapshot  Json?
  expiresAt     DateTime?
  attribution   AttributionContext? @relation(fields: [attributionId], references: [id], onDelete: Restrict)
  credits       ReferralCredit[]
}

model RiskEvent {
  id        String   @id @default(cuid())
  userId    String
  kind      String
  detail    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  targetId  String
  details   Json
  requestId String?
  createdAt DateTime @default(now())
  actor     User?    @relation(fields: [actorId], references: [id])

  @@index([targetId, createdAt])
}

enum AttributionSource {
  CREATOR_PROFILE
  CREATOR_LINK
  EVENT
  REFERRAL
  CAMPAIGN
  SPONSORED_MISSION
  SHARE_LINK
  DIRECT
}

model ShareLink {
  id           String               @id @default(cuid())
  slug         String               @unique
  canonicalKey String               @unique
  ownerId      String
  creatorId    String?
  referrerId   String?
  campaignId   String?
  eventId      String?
  source       AttributionSource
  active       Boolean              @default(true)
  isDemo       Boolean              @default(false)
  createdAt    DateTime             @default(now())
  owner        User                 @relation("ShareOwner", fields: [ownerId], references: [id])
  creator      User?                @relation("ShareCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  referrer     User?                @relation("ShareReferrer", fields: [referrerId], references: [id], onDelete: Restrict)
  campaign     Campaign?            @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  event        Event?               @relation(fields: [eventId], references: [id], onDelete: Restrict)
  contexts     AttributionContext[]
  growthEvents GrowthEvent[]

  @@index([creatorId, source])
}

model AttributionContext {
  id             String            @id @default(cuid())
  tokenHash      String            @unique
  visitorHash    String
  creatorId      String?
  referrerId     String?
  boundUserId    String?
  shareLinkId    String
  campaignId     String?
  eventId        String?
  source         AttributionSource
  ruleVersion    String
  policySnapshot Json
  status         String            @default("ACTIVE")
  firstTouchAt   DateTime          @default(now())
  lastTouchAt    DateTime          @default(now())
  expiresAt      DateTime
  boundAt        DateTime?
  isDemo         Boolean           @default(false)
  creator        User?             @relation("AttributionCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  referrer       User?             @relation("AttributionReferrer", fields: [referrerId], references: [id], onDelete: Restrict)
  boundUser      User?             @relation("AttributionAccount", fields: [boundUserId], references: [id], onDelete: Restrict)
  shareLink      ShareLink         @relation(fields: [shareLinkId], references: [id])
  campaign       Campaign?         @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  event          Event?            @relation(fields: [eventId], references: [id], onDelete: Restrict)
  activities     Activity[]
  referral       Referral?
  growthEvents   GrowthEvent[]

  @@index([visitorHash, expiresAt])
  @@index([creatorId, firstTouchAt])
  @@index([boundUserId, expiresAt])
  @@index([expiresAt])
}

model GrowthEvent {
  id            String              @id @default(cuid())
  dedupeKey     String              @unique
  type          String
  attributionId String?
  shareLinkId   String?
  creatorId     String?
  userId        String?
  campaignId    String?
  eventId       String?
  isDemo        Boolean             @default(false)
  occurredAt    DateTime            @default(now())
  attribution   AttributionContext? @relation(fields: [attributionId], references: [id], onDelete: Restrict)
  shareLink     ShareLink?          @relation(fields: [shareLinkId], references: [id], onDelete: Restrict)
  creator       User?               @relation("GrowthCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  user          User?               @relation("GrowthActor", fields: [userId], references: [id], onDelete: Restrict)
  campaign      Campaign?           @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  event         Event?              @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@index([creatorId, type, occurredAt])
  @@index([type, occurredAt])
  @@index([campaignId, type])
  @@index([eventId, type])
}

model ReferralCredit {
  id           String     @id @default(cuid())
  referralId   String
  activityId   String     @unique
  rewardUnitId String     @unique
  periodKey    String
  amountMicros BigInt
  ruleVersion  String
  createdAt    DateTime   @default(now())
  referral     Referral   @relation(fields: [referralId], references: [id])
  activity     Activity   @relation(fields: [activityId], references: [id])
  rewardUnit   RewardUnit @relation(fields: [rewardUnitId], references: [id])

  @@index([referralId, periodKey])
}

model EventSettlement {
  id              String    @id @default(cuid())
  eventId         String
  createdById     String
  ruleVersion     String
  snapshot        Json
  fingerprint     String
  state           String    @default("PREVIEW")
  idempotencyKey  String?   @unique
  finalizePayload String?
  finalizedAt     DateTime?
  createdAt       DateTime  @default(now())
  event           Event     @relation(fields: [eventId], references: [id])
  createdBy       User      @relation(fields: [createdById], references: [id])

  @@index([eventId, state])
}

model EventOperation {
  id             String   @id @default(cuid())
  eventId        String
  actorId        String
  idempotencyKey String   @unique
  kind           String
  payloadHash    String
  result         Json
  createdAt      DateTime @default(now())
  event          Event    @relation(fields: [eventId], references: [id])
  actor          User     @relation(fields: [actorId], references: [id])

  @@index([eventId, createdAt])
}

model MfaCredential {
  user                User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId              String    @id
  secretCiphertext    String
  lastAcceptedCounter BigInt    @default(-1)
  enabledAt           DateTime  @default(now())
  disabledAt          DateTime?
}

model MfaEnrollment {
  user             User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  session          Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  id               String    @id
  userId           String    @unique
  sessionId        String
  secretCiphertext String
  expiresAt        DateTime
  consumedAt       DateTime?
  createdAt        DateTime  @default(now())
}

model MfaRecoveryCode {
  user       User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  digest     String    @id
  userId     String
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model EmailSecurityToken {
  user       User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  digest     String    @id
  userId     String
  purpose    String
  email      String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, purpose, createdAt])
  @@index([expiresAt])
}

model MailOutbox {
  user              User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  id                String    @id
  userId            String
  purpose           String
  payloadCiphertext String
  status            String    @default("PENDING")
  attempts          Int       @default(0)
  nextAttemptAt     DateTime  @default(now())
  lockedUntil       DateTime?
  leaseToken        String?
  deliveredAt       DateTime?
  providerReference String?
  lastErrorCode     String?
  createdAt         DateTime  @default(now())

  @@index([status, nextAttemptAt])
  @@index([userId, createdAt])
}

model FinancialApproval {
  requester    User      @relation("ApprovalRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  approver     User?     @relation("ApprovalReviewer", fields: [approverId], references: [id], onDelete: Restrict)
  id           String    @id
  requesterId  String
  approverId   String?
  operation    String
  targetId     String
  payload      Json
  payloadHash  String
  ruleVersion  String
  reason       String
  reviewReason String?
  state        String    @default("REQUESTED")
  expiresAt    DateTime
  reviewedAt   DateTime?
  executedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([state, createdAt])
  @@index([requesterId, createdAt])
}

model PaymentOperation {
  user                User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  parent              PaymentOperation?  @relation("PaymentParent", fields: [parentId], references: [id], onDelete: Restrict)
  corrections         PaymentOperation[] @relation("PaymentParent")
  ledgerTransaction   LedgerTransaction? @relation(fields: [ledgerTransactionId], references: [id], onDelete: Restrict)
  id                  String             @id
  userId              String
  provider            String
  kind                String
  externalId          String?
  idempotencyKey      String             @unique
  payloadHash         String
  amountMinor         BigInt
  currency            String             @default("EUR")
  state               String             @default("REQUESTED")
  parentId            String?
  ledgerTransactionId String?            @unique
  isDemo              Boolean            @default(false)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@unique([provider, externalId])
  @@index([userId, createdAt])
  @@index([parentId, kind])
}

model WebhookEvent {
  conversions   ProviderConversion[]
  id            String               @id
  provider      String
  externalId    String
  eventType     String
  payload       Json
  payloadHash   String
  occurredAt    DateTime
  status        String               @default("RECEIVED")
  attempts      Int                  @default(0)
  nextAttemptAt DateTime             @default(now())
  lockedUntil   DateTime?
  leaseToken    String?
  processedAt   DateTime?
  lastErrorCode String?
  isDemo        Boolean              @default(false)
  createdAt     DateTime             @default(now())

  @@unique([provider, externalId])
  @@index([status, nextAttemptAt])
}

model ProviderConversion {
  activity        Activity     @relation(fields: [activityId], references: [id], onDelete: Restrict)
  campaign        Campaign     @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  latestWebhook   WebhookEvent @relation(fields: [latestWebhookId], references: [id], onDelete: Restrict)
  id              String       @id
  provider        String
  externalId      String
  activityId      String
  campaignId      String
  convertedAt     DateTime
  valueMinor      BigInt?
  currency        String       @default("EUR")
  decision        String
  latestWebhookId String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([provider, externalId])
  @@unique([provider, activityId])
  @@index([activityId, campaignId])
}
